{
  "name": "@template/api",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --exec tsx ./src/index.ts",
    "build": "tsc",
    "format": "prettier --write src --ignore-path .prettierignore",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "migrate": "prisma migrate dev && prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio --browser none --port 5555",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/body-parser": "^1.19.6",
    "@types/http-errors": "^2.0.5",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@template/eslint-config": "workspace:*",
    "@template/prettier-config": "workspace:*",
    "@template/schemas": "workspace:*",
    "@template/vitest-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.0.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
